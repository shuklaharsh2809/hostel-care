# Leave DATABASE_URL empty to use the embedded local Postgres (PGlite) stored in ./.data
DATABASE_URL=
# Long random string used to sign API tokens (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=4000
# Comma-separated origins allowed to call the API from a browser (future student web/mobile apps)
CORS_ORIGINS=http://localhost:3000
# Where uploaded files (student photos) are stored on disk
UPLOAD_DIR=./uploads
